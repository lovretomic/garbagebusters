generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  ID_Report String @id

  //other, TODO: ADD

  cleanup_action Cleanup_Action?
}

model Cleanup_Action {
  ID_Report      String   @id
  name           String
  description    String
  max_volunteers Int
  action_date    DateTime
  action_time    DateTime @db.Time

  report Report @relation(fields: [ID_Report], references: [ID_Report])
}

